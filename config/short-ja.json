{
  "project": "AIツールウォッチ",
  "language": "ja-JP",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "duration_seconds": {
    "min": 10,
    "max": 15
  },
  "editorial": {
    "hook_deadline_seconds": 3,
    "one_story_per_video": true,
    "prefer_primary_sources": true,
    "prohibit_exaggeration": true,
    "label_inference": true
  },
  "opening_hook": {
    "window_seconds": {
      "start": 0,
      "end": 3
    },
    "thumbnail_grade_required": true,
    "goal": "冒頭3秒だけを静止画として見ても、ニュースの要点と見たくなる理由が一瞬で伝わること",
    "thumbnail_styles": {
      "A": {
        "name": "号外・新聞見出し風",
        "use_for": ["risk", "regulation", "security", "outage", "controversy", "urgent_problem"]
      },
      "B": {
        "name": "雑誌表紙・編集特集風",
        "use_for": ["trend", "industry_shift", "why_it_matters", "agent", "model_positioning", "market_change"]
      },
      "C": {
        "name": "シンプル断言ポスター風",
        "use_for": ["feature", "performance", "memory", "context", "speed", "voice", "ui", "clear_user_benefit"]
      }
    },
    "requirements": {
      "understandable_without_audio": true,
      "topic_clear_at_a_glance": true,
      "core_point_clear_at_a_glance": true,
      "phone_readable_while_scrolling": true,
      "one_screen_one_message": true,
      "large_headline": true,
      "headline_max_lines": 2,
      "headline_target_chars_per_line": 9,
      "high_contrast": true,
      "single_dominant_visual": true,
      "prefer_clear_subject_image": true,
      "support_copy_visible_during_thumbnail_window": false,
      "subtitle_visible_during_thumbnail_window": false,
      "prefer_hook_elements": [
        "conclusion",
        "surprise",
        "tension",
        "clear_benefit",
        "question"
      ]
    },
    "avoid": [
      "small_body_copy",
      "multiple_competing_messages",
      "generic_ai_icon_collage",
      "robot_chip_shield_flowchart_cliche",
      "abstract_term_only_headline",
      "slow_context_before_the_point",
      "audio_dependent_hook",
      "sensational_claims_not_supported_by_sources"
    ]
  },
  "captions": {
    "max_chars_per_cue": 18,
    "max_lines": 2,
    "safe_margin_px": {
      "horizontal": 90,
      "top": 160,
      "bottom": 260
    }
  },
  "qa": {
    "extract_opening_frames": true,
    "opening_frame_sampling": {
      "whole_seconds": [0.0, 1.0, 2.0],
      "include_last_frame": true,
      "fps": 30
    },
    "opening_review_required": [
      "phone_readability",
      "topic_clarity",
      "core_point_clarity",
      "visual_impact",
      "works_without_audio",
      "thumbnail_style_fit",
      "single_dominant_visual",
      "no_tiny_explanatory_copy"
    ],
    "auto_fix_and_rerender_on_failure": true
  },
  "outro": {
    "text": "AIツールウォッチ",
    "duration_seconds": 1.2
  }
}
